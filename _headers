# Cloudflare Pages y Netlify. En otro alojamiento (GitHub Pages, por ejemplo) estas cabeceras se
# ignoran y queda la política que ya va dentro del HTML (etiqueta meta de Layout.astro).

/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# El HTML se revalida en cada visita para que un despliegue se vea de inmediato.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Los archivos con el hash en el nombre no cambian nunca.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
